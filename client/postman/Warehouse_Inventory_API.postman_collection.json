{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-warehouse001",
    "name": "Warehouse Inventory API",
    "description": "REST API collection for the Warehouse Inventory Management System.\n\n## Quick start\n1. Set `baseUrl` (default `http://localhost:5000/api/v1`).\n2. Run **Auth → Login** (admin credentials are prefilled from seed).\n3. Token is saved automatically to `token`.\n4. Other requests use `Authorization: Bearer {{token}}`.\n\n## Roles\n- `ADMIN` — products, warehouses, users, inventory, dashboard\n- `WAREHOUSE_STAFF` — view catalog + inventory operations + dashboard\n\n## Response shape\n```json\n{ \"success\": true, \"message\": \"...\", \"data\": {} }\n{ \"success\": false, \"message\": \"...\", \"errors\": [] }\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@warehouse.local" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "staffEmail", "value": "staff@warehouse.local" },
    { "key": "staffPassword", "value": "Staff@12345" },
    { "key": "userId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "sourceWarehouseId", "value": "" },
    { "key": "destinationWarehouseId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public health check. No auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login with email/password. Saves JWT to collection variable `token`."
          },
          "response": []
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Returns the authenticated user. Requires Bearer token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Stateless logout. Client should discard the token after success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('userId', body.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warehouse Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\",\n  \"role\": \"WAREHOUSE_STAFF\"\n}"
            },
            "url": "{{baseUrl}}/users",
            "description": "Admin only. Create a user.\n\nRoles: `ADMIN` | `WAREHOUSE_STAFF`"
          },
          "response": []
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users",
            "description": "Admin only. List all users."
          },
          "response": []
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Admin only. Get a single user."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Staff Name\",\n  \"role\": \"WAREHOUSE_STAFF\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Admin only. Update name, role, and/or isActive."
          },
          "response": []
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Admin only. Soft-deactivates the user (`isActive: false`)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('productId', body.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"sku\": \"LAP-001\",\n  \"category\": \"Electronics\",\n  \"price\": 50000,\n  \"minimumStockLevel\": 10\n}"
            },
            "url": "{{baseUrl}}/products",
            "description": "Admin only. Create a product. SKU must be unique."
          },
          "response": []
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?search=&page=1&limit=20",
            "description": "Authenticated. List products with optional search and pagination.\n\nQuery: `search`, `page`, `limit`"
          },
          "response": []
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Authenticated. Get a single product."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro\",\n  \"price\": 55000,\n  \"minimumStockLevel\": 15\n}"
            },
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Admin only. Partial update of product fields."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}",
            "description": "Admin only. Soft delete. Blocked if product has stock quantity > 0."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "Create Warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('warehouseId', body.data.id);",
                  "    pm.collectionVariables.set('sourceWarehouseId', body.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmedabad Warehouse\",\n  \"location\": \"Ahmedabad\",\n  \"capacity\": 1000\n}"
            },
            "url": "{{baseUrl}}/warehouses",
            "description": "Admin only. Create warehouse. Name must be unique (case-insensitive). Capacity is a hard stock limit."
          },
          "response": []
        },
        {
          "name": "Create Destination Warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) {",
                  "    pm.collectionVariables.set('destinationWarehouseId', body.data.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Surat Warehouse\",\n  \"location\": \"Surat\",\n  \"capacity\": 500\n}"
            },
            "url": "{{baseUrl}}/warehouses",
            "description": "Helper request to create a second warehouse for transfer testing. Saves `destinationWarehouseId`."
          },
          "response": []
        },
        {
          "name": "List Warehouses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/warehouses?page=1&limit=20",
            "description": "Authenticated. List warehouses with pagination.\n\nQuery: `page`, `limit`"
          },
          "response": []
        },
        {
          "name": "Get Warehouse By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/warehouses/{{warehouseId}}",
            "description": "Authenticated. Get a single warehouse."
          },
          "response": []
        },
        {
          "name": "Update Warehouse",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Ahmedabad East\",\n  \"capacity\": 1200\n}"
            },
            "url": "{{baseUrl}}/warehouses/{{warehouseId}}",
            "description": "Admin only. Partial update of warehouse fields."
          },
          "response": []
        },
        {
          "name": "Delete Warehouse",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/warehouses/{{warehouseId}}",
            "description": "Admin only. Soft delete. Blocked if warehouse has stock quantity > 0."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "List Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory?productId=&warehouseId=&search=&page=1&limit=20",
            "description": "Authenticated. List inventory records with optional filters.\n\nQuery: `productId`, `warehouseId`, `search`, `page`, `limit`"
          },
          "response": []
        },
        {
          "name": "Add Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"warehouseId\": \"{{sourceWarehouseId}}\",\n  \"quantity\": 50\n}"
            },
            "url": "{{baseUrl}}/inventory/add",
            "description": "Admin and Staff. Quantity must be > 0. Rejected if warehouse capacity would be exceeded."
          },
          "response": []
        },
        {
          "name": "Remove Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"warehouseId\": \"{{sourceWarehouseId}}\",\n  \"quantity\": 5\n}"
            },
            "url": "{{baseUrl}}/inventory/remove",
            "description": "Admin and Staff. Quantity must be > 0. Rejected if insufficient stock."
          },
          "response": []
        },
        {
          "name": "Transfer Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"sourceWarehouseId\": \"{{sourceWarehouseId}}\",\n  \"destinationWarehouseId\": \"{{destinationWarehouseId}}\",\n  \"quantity\": 10\n}"
            },
            "url": "{{baseUrl}}/inventory/transfer",
            "description": "Admin and Staff. Source and destination must differ. Checks source stock and destination capacity."
          },
          "response": []
        },
        {
          "name": "Low Stock Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory/low-stock",
            "description": "Authenticated. Products where total stock across all warehouses is below minimumStockLevel."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/summary",
            "description": "Authenticated. Returns totalProducts, totalWarehouses, totalStockQuantity, lowStockProducts."
          },
          "response": []
        }
      ]
    }
  ]
